# Copy to .env (or export) and adjust. Every setting has a default; see app/core/config.py.
OPSIB_DATABASE_URL=postgresql+psycopg://opsib:opsib@localhost:5432/opsib
OPSIB_TENANT_ID=demo-retailer
# Frozen evaluation time from the fixture README. Use "system" for the live clock.
OPSIB_EVALUATION_TIME=2026-10-16T15:00:00+05:30
OPSIB_AVAILABILITY_MAX_AGE_MINUTES=60
OPSIB_SHORTFALL_TOLERANCE_BASE_UNITS=0
OPSIB_TASK_DUE_HOURS=24
# Optional AI summaries: disabled | claude (needs OPSIB_ANTHROPIC_API_KEY). Disabled by default.
OPSIB_AI_PROVIDER=disabled
OPSIB_LOG_LEVEL=INFO
